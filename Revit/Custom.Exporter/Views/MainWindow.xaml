<Window
    x:Class="Custom.Exporter.MainWindow "
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Custom.Exporter"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Custom.Exporter.Views"
    Title="Custom Exporter"
    Width="600"
    Height="450"
    DataContext="{Binding RelativeSource={RelativeSource Self}, Path=ViewModel}"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary Source="/Custom.Exporter;component/StyleResources.xaml" />
    </Window.Resources>
    <Grid>
        <views:WidgetTest Height="300" VerticalAlignment="Top" />
    </Grid>
</Window>
